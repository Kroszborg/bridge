{
  "name": "@kroszborg/bridge",
  "version": "0.4.0-rc.1",
  "description": "TypeScript SDK for Bridge, open-source SMS through your own Android phones: send messages, follow delivery, verify phone numbers, stream events and verify webhooks.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kroszborg/bridge.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/kroszborg/bridge/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/kroszborg/bridge/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "sms",
    "otp",
    "android",
    "sms-gateway",
    "webhooks",
    "bridge"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@bridge/api-types": "workspace:*",
    "@types/node": "26.6.4",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
