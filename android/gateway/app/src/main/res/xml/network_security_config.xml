<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-hosted Bridge servers on a local network often run without TLS, so plain
  HTTP is allowed. The app warns before pairing with an http:// server.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
