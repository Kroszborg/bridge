<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's preview (Android 12+); mirrors the small layout in GatewayWidget.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="6dp"
        android:drawableStart="@drawable/widget_dot"
        android:drawableTint="@color/widget_success"
        android:gravity="center_vertical"
        android:text="@string/widget_preview_status"
        android:textColor="@color/widget_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/widget_preview_project"
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />
</LinearLayout>
